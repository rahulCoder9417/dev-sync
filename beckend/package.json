{
  "name": "dev-sync-backend",
  "version": "1.0.0",
  "description": "Backend WebSocket server for coding collaboration",
  "type": "module",
  "main": "dist/server.ts",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc",
    "dev": "tsx watch server.ts",
    "start": "node dist/server.ts",
    "dev:ts": "nodemon --exec tsx server.ts"
  },
  "keywords": [
    "websocket",
    "collaboration",
    "express",
    "real-time"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clerk/backend": "^2.9.4",
    "@prisma/client": "^6.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.14.0",
    "ws": "^8.14.2",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.27",
    "zod": "^4.1.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "nodemon": "^3.0.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  }
}
