{
  "name": "dev-sync-backend",
  "version": "1.0.0",
  "description": "Backend WebSocket server for coding collaboration",
  "type": "module",
  "main": "dist/server.ts",
  "scripts": {
    "postinstall": "prisma generate",
    "prebuild": "npm install @types/node dotenv",
    "build": "tsc",
    "dev": "tsx watch server.ts",
    "start": "node dist/server.js",
    "dev:ts": "nodemon --exec tsx server.ts"
  },
  "keywords": [
    "websocket",
    "collaboration",
    "express",
    "real-time"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clerk/backend": "^2.9.4",
    "@octokit/core": "^7.0.6",
    "@prisma/client": "^5.22.0",
    "@types/node": "^25.0.3",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "fflate": "^0.8.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "prisma": "^5.22.0",
    "ws": "^8.14.2",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.27",
    "zod": "^4.1.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/ws": "^8.5.10"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  }
}